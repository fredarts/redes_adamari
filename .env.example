# =======================================================================
# CONFIGURAÇÃO MERCADO PAGO — REDES ADAMARI
# Copie este arquivo para .env.local e preencha seu Access Token real
# =======================================================================

# Chave Secreta (Access Token) do Mercado Pago (Produção ou Teste)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=

# URL pública do seu site (ex: https://redesadamari.com.br ou http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número do WhatsApp da loja para atendimento e envio de comprovante (com DDI 55 + DDD)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

